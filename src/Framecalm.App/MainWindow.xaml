<Window x:Class="Framecalm.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Framecalm.App.ViewModels"
        xmlns:c="clr-namespace:Framecalm.App.Controls"
        Title="Framecalm" Width="1280" Height="800" MinWidth="1080" MinHeight="680"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
        FontFamily="{StaticResource Ui}" WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="64" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Views/Pages.xaml" />
                <ResourceDictionary Source="Views/Optimize.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- top navigation: plain words, the current one in white with a glowing amber line under it -->
            <Style x:Key="TopNav" TargetType="RadioButton">
                <Setter Property="FocusVisualStyle" Value="{StaticResource Focus}" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Foreground" Value="{StaticResource Muted}" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="FontWeight" Value="Medium" />
                <Setter Property="Margin" Value="0,0,30,0" />
                <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Grid Background="Transparent">
                                <ContentPresenter VerticalAlignment="Center" Margin="0,0,0,2" />
                                <Rectangle x:Name="bar" Height="2" Fill="{StaticResource Accent}" VerticalAlignment="Bottom" Margin="0,0,0,14" RadiusX="1" RadiusY="1" Opacity="0">
                                    <Rectangle.Effect><DropShadowEffect Color="#FFB224" BlurRadius="10" ShadowDepth="0" Opacity="0.8" /></Rectangle.Effect>
                                </Rectangle>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{StaticResource Text}" /></Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource Text}" />
                                    <Setter TargetName="bar" Property="Opacity" Value="1" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- tabs inside a section: smaller, a soft filled chip for the current one -->
            <Style x:Key="SubTab" TargetType="RadioButton">
                <Setter Property="FocusVisualStyle" Value="{StaticResource Focus}" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Foreground" Value="{StaticResource Muted}" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="Medium" />
                <Setter Property="Margin" Value="0,0,6,0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="b" CornerRadius="10" Padding="14,7" Background="Transparent" BorderThickness="1" BorderBrush="Transparent">
                                <ContentPresenter VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{StaticResource Text}" /></Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource Text}" />
                                    <Setter TargetName="b" Property="Background" Value="#241F66" />
                                    <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Line2}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid x:Name="Root">
        <!-- the same indigo glow as the website, lit from the top right -->
        <Grid.Background>
            <RadialGradientBrush Center="0.72,0" GradientOrigin="0.72,0" RadiusX="0.9" RadiusY="0.8">
                <GradientStop Color="#2A2580" Offset="0" />
                <GradientStop Color="#16124A" Offset="0.45" />
                <GradientStop Color="#0E0B2E" Offset="1" />
            </RadialGradientBrush>
        </Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===== top bar ===== -->
        <Grid Margin="32,0,0,0" Panel.ZIndex="10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Viewbox Width="28" Height="28">
                    <Canvas Width="24" Height="24">
                        <Rectangle Width="24" Height="24" RadiusX="5.3" RadiusY="5.3" Fill="{StaticResource Accent}" />
                        <Path Data="M9.2,19 V9.6 A4,4 0 0 1 13.2,5.6 H14.5 M5.4,12.2 H19" Stroke="{StaticResource Ink}" StrokeThickness="2.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                    </Canvas>
                </Viewbox>
                <TextBlock Text="framecalm" FontSize="20" FontWeight="SemiBold" Margin="10,0,0,2" VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="56,0,0,0" Visibility="{Binding ShowNav, Converter={StaticResource VisIf}}"
                        KeyboardNavigation.TabNavigation="Once" KeyboardNavigation.DirectionalNavigation="Cycle">
                <RadioButton Style="{StaticResource TopNav}" Content="Home" IsChecked="{Binding GroupHome}" AutomationProperties.Name="Home" />
                <RadioButton Style="{StaticResource TopNav}" IsChecked="{Binding GroupOptimize}" AutomationProperties.Name="Optimize: tweaks, PC fixes and startup apps">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Optimize" />
                        <TextBlock Text="{Binding OptimizeCount}" FontSize="12.5" FontWeight="Normal" Foreground="{StaticResource Faint}" Margin="8,1,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource TopNav}" Content="Games" IsChecked="{Binding GroupGames}" AutomationProperties.Name="Games: library, Game Session and benchmarks" />
                <RadioButton Style="{StaticResource TopNav}" Content="History" IsChecked="{Binding TabHistory}" AutomationProperties.Name="History and undo" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" Height="64">
                <Button Style="{StaticResource Plain}" Command="{Binding GetUpdateCmd}" Visibility="{Binding HasUpdate, Converter={StaticResource VisIf}}" VerticalAlignment="Center" Margin="0,0,18,0"
                        WindowChrome.IsHitTestVisibleInChrome="True" Cursor="Hand" ToolTip="Download and install the new version">
                    <Border Background="#2B2773" BorderBrush="{StaticResource Accent}" BorderThickness="1" CornerRadius="10" Padding="12,6">
                        <TextBlock FontSize="12.5" FontWeight="Medium" Foreground="White"><Run Text="{Binding UpdateText, Mode=OneWay}" /><Run Text="{Binding UpdateAction, Mode=OneWay}" FontWeight="SemiBold" /></TextBlock>
                    </Border>
                </Button>
                <Border Visibility="{Binding IsDemo, Converter={StaticResource VisIf}}" BorderBrush="{StaticResource Warn}" BorderThickness="1" CornerRadius="8" Padding="10,4" VerticalAlignment="Center" Margin="0,0,18,0"
                        ToolTip="Demo mode: a made-up laptop with made-up numbers. None of your games or settings are read or changed.">
                    <TextBlock Text="Demo PC" FontSize="12" FontWeight="Medium" Foreground="{StaticResource Warn}" />
                </Border>
                <RadioButton Style="{StaticResource TopNav}" IsChecked="{Binding TabSettings}" Margin="0,0,14,0" AutomationProperties.Name="Settings" ToolTip="Settings"
                             Visibility="{Binding ShowNav, Converter={StaticResource VisIf}}">
                    <TextBlock Text="&#xE713;" Style="{StaticResource Icon}" FontSize="16" />
                </RadioButton>
                <Button x:Name="MinBtn" Style="{StaticResource WinBtn}" Content="&#xE921;" Click="Min_Click" VerticalAlignment="Top" AutomationProperties.Name="Minimize" />
                <Button x:Name="MaxBtn" Style="{StaticResource WinBtn}" Content="&#xE922;" Click="Max_Click" VerticalAlignment="Top" AutomationProperties.Name="Maximize" />
                <Button x:Name="CloseBtn" Style="{StaticResource WinBtn}" Content="&#xE8BB;" Click="Close_Click" VerticalAlignment="Top" AutomationProperties.Name="Close" />
            </StackPanel>
        </Grid>

        <!-- ===== content: the section's tabs, then the page ===== -->
        <Grid Grid.Row="1" Visibility="{Binding ShowNav, Converter={StaticResource VisIf}}">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Margin="56,4,0,4" Visibility="{Binding ShowOptimizeTabs, Converter={StaticResource VisIf}}">
                <RadioButton Style="{StaticResource SubTab}" GroupName="opt" Content="Tweaks" IsChecked="{Binding TabOptimize}" />
                <RadioButton Style="{StaticResource SubTab}" GroupName="opt" Content="PC fixes" IsChecked="{Binding TabHealth}" />
                <RadioButton Style="{StaticResource SubTab}" GroupName="opt" Content="Startup apps" IsChecked="{Binding TabStartup}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="56,4,0,4" Visibility="{Binding ShowGamesTabs, Converter={StaticResource VisIf}}">
                <RadioButton Style="{StaticResource SubTab}" GroupName="games" Content="Library" IsChecked="{Binding TabLibrary}" />
                <RadioButton Style="{StaticResource SubTab}" GroupName="games" Content="Game Session" IsChecked="{Binding TabSession}" />
                <RadioButton Style="{StaticResource SubTab}" GroupName="games" Content="Benchmarks" IsChecked="{Binding TabProof}" />
            </StackPanel>
            <ContentControl x:Name="PageHost" Grid.Row="1" Content="{Binding Page}" Focusable="False" IsTabStop="False">
                <ContentControl.RenderTransform><TranslateTransform /></ContentControl.RenderTransform>
            </ContentControl>
        </Grid>

        <!-- the welcome screen fills the whole window, under the window buttons -->
        <ContentControl Grid.RowSpan="2" Content="{Binding Page}" Focusable="False" IsTabStop="False" Visibility="{Binding ShowNav, Converter={StaticResource VisIfNot}}" />

        <!-- ===== toast ===== -->
        <Border x:Name="ToastBox" Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,104" MaxWidth="660" Panel.ZIndex="20"
                Background="{StaticResource Surface2}" BorderBrush="{StaticResource Line2}" BorderThickness="1" CornerRadius="12" Padding="18,12"
                Visibility="{Binding Toast, Converter={StaticResource VisIf}}">
            <Border.Effect><DropShadowEffect Color="#000000" BlurRadius="30" ShadowDepth="0" Opacity="0.5" /></Border.Effect>
            <StackPanel Orientation="Horizontal">
                <Rectangle Width="3" Margin="0,1,12,1" RadiusX="1.5" RadiusY="1.5">
                    <Rectangle.Style>
                        <Style TargetType="Rectangle">
                            <Setter Property="Fill" Value="{StaticResource Accent}" />
                            <Style.Triggers><DataTrigger Binding="{Binding ToastBad}" Value="True"><Setter Property="Fill" Value="{StaticResource Bad}" /></DataTrigger></Style.Triggers>
                        </Style>
                    </Rectangle.Style>
                </Rectangle>
                <TextBlock Text="{Binding Toast}" Style="{StaticResource Body}" Foreground="{StaticResource Text}" MaxWidth="610" AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
        </Border>

        <!-- ===== dialog ===== -->
        <Grid Grid.RowSpan="2" Panel.ZIndex="30" Visibility="{Binding Dialog, Converter={StaticResource VisIf}}">
            <Rectangle Fill="#D90A0824" />
            <ContentControl Content="{Binding Dialog}" HorizontalAlignment="Center" VerticalAlignment="Center" Focusable="False" />
        </Grid>

        <!-- ===== scripted cursor (recordings only) ===== -->
        <Canvas x:Name="FakeCursorLayer" Grid.RowSpan="2" Panel.ZIndex="40" IsHitTestVisible="False" Visibility="Collapsed">
            <Ellipse x:Name="ClickRing" Width="44" Height="44" Stroke="{StaticResource Accent}" StrokeThickness="2.5" Opacity="0" RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform><ScaleTransform /></Ellipse.RenderTransform>
            </Ellipse>
            <Path x:Name="FakeCursor" Data="M0,0 L0,17 L4.6,12.8 L7.6,19.6 L10.4,18.4 L7.5,11.8 L13.4,11.8 Z" Fill="White" Stroke="Black" StrokeThickness="1.1" StrokeLineJoin="Round" />
        </Canvas>
    </Grid>
</Window>
