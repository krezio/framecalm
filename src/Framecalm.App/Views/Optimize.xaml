                        <Ellipse Canvas.Left="54" Canvas.Top="47" Width="16" Height="16" Fill="#1E1A63" Stroke="#8F8BFF" StrokeThickness="2" />
                        <Ellipse Canvas.Left="138" Canvas.Top="47" Width="16" Height="16" Fill="#1E1A63" Stroke="#8F8BFF" StrokeThickness="2" />
                    </Canvas>
                </Viewbox>
                <Viewbox Style="{StaticResource Drift}" Canvas.Left="400" Canvas.Top="250" Width="120">
                    <Canvas Width="120" Height="120">
                        <Path Data="M30,10 V22 M45,10 V22 M60,10 V22 M75,10 V22 M90,10 V22 M30,98 V110 M45,98 V110 M60,98 V110 M75,98 V110 M90,98 V110 M10,30 H22 M10,45 H22 M10,60 H22 M10,75 H22 M10,90 H22 M98,30 H110 M98,45 H110 M98,60 H110 M98,75 H110 M98,90 H110" Stroke="#8F8BFF" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        <Rectangle Canvas.Left="22" Canvas.Top="22" Width="76" Height="76" RadiusX="8" RadiusY="8" Fill="#1E1A63" Stroke="#8F8BFF" StrokeThickness="2" />
                        <Rectangle Canvas.Left="38" Canvas.Top="38" Width="44" Height="44" RadiusX="4" RadiusY="4" Fill="#2E2992" Stroke="#8F8BFF" StrokeThickness="2" />
                    </Canvas>
                </Viewbox>
                <Viewbox Style="{StaticResource Drift}" Canvas.Left="60" Canvas.Top="380" Width="280">
                    <Canvas Width="240" Height="60">
                        <Canvas.RenderTransform><RotateTransform Angle="-18" CenterX="120" CenterY="30" /></Canvas.RenderTransform>
                        <Path Data="M4,8 H236 V48 H126 V56 H114 V48 H4 Z" Fill="#1E1A63" Stroke="#8F8BFF" StrokeThickness="2" StrokeLineJoin="Round" />
                        <Rectangle Canvas.Left="16" Canvas.Top="16" Width="30" Height="22" RadiusX="2" RadiusY="2" Fill="#2E2992" Stroke="#8F8BFF" StrokeThickness="2" />
                        <Rectangle Canvas.Left="56" Canvas.Top="16" Width="30" Height="22" RadiusX="2" RadiusY="2" Fill="#2E2992" Stroke="#8F8BFF" StrokeThickness="2" />
                        <Rectangle Canvas.Left="96" Canvas.Top="16" Width="30" Height="22" RadiusX="2" RadiusY="2" Fill="#2E2992" Stroke="#8F8BFF" StrokeThickness="2" />
                        <Rectangle Canvas.Left="136" Canvas.Top="16" Width="30" Height="22" RadiusX="2" RadiusY="2" Fill="#2E2992" Stroke="#8F8BFF" StrokeThickness="2" />
                        <Rectangle Canvas.Left="176" Canvas.Top="16" Width="30" Height="22" RadiusX="2" RadiusY="2" Fill="#2E2992" Stroke="#8F8BFF" StrokeThickness="2" />
                    </Canvas>
                </Viewbox>
                <Viewbox Style="{StaticResource Drift}" Canvas.Left="70" Canvas.Top="210" Width="34">
                    <Viewbox.Effect><DropShadowEffect Color="#FFB224" BlurRadius="24" ShadowDepth="0" Opacity="0.9" /></Viewbox.Effect>
                    <Canvas Width="60" Height="120">
                        <Path Data="M30,4 L54,38 L30,116 L6,38 Z" Fill="#FFB224" Stroke="#FFE3A6" StrokeThickness="2" StrokeLineJoin="Round" />
                        <Path Data="M6,38 H54 M30,4 L18,38 L30,116 L42,38 Z" Stroke="#8A5A00" StrokeThickness="2" StrokeLineJoin="Round" />
                    </Canvas>
                </Viewbox>
                <Viewbox Style="{StaticResource Drift}" Canvas.Left="470" Canvas.Top="70" Width="44">
                    <Viewbox.Effect><DropShadowEffect Color="#7CF5C0" BlurRadius="22" ShadowDepth="0" Opacity="0.85" /></Viewbox.Effect>
                    <Canvas Width="100" Height="100">
                        <Path Data="M50,6 L92,28 V72 L50,94 L8,72 V28 Z" Fill="#7CF5C0" Stroke="#D6FFEE" StrokeThickness="2" StrokeLineJoin="Round" />
                        <Path Data="M8,28 L50,50 L92,28 M50,50 V94" Stroke="#2E8F6A" StrokeThickness="2" StrokeLineJoin="Round" />
                    </Canvas>
                </Viewbox>
            </Canvas>

            <!-- the words and the one button, like the website's hero -->
            <Grid Margin="56,10,56,40">
                <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <StackPanel VerticalAlignment="Center" MaxWidth="640" HorizontalAlignment="Left" c:Entrance.Delay="40">
                    <TextBlock Text="{Binding Machine}" FontSize="14" Foreground="{StaticResource Faint}" />
                    <TextBlock Text="{Binding HomeTitle}" FontSize="68" FontWeight="Medium" Foreground="{StaticResource Text}" LineHeight="70" LineStackingStrategy="BlockLineHeight" Margin="0,14,0,0" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding StatusText}" FontSize="17" LineHeight="27" Foreground="{StaticResource Muted}" TextWrapping="Wrap" MaxWidth="520" HorizontalAlignment="Left" Margin="0,22,0,30" />
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource Primary}" Command="{Binding OptimizeCmd}" Padding="26,16" FontSize="17" AutomationProperties.Name="Optimize this PC">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding ButtonText}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <Border Background="{StaticResource Ink}" CornerRadius="8" Width="34" Height="34" Margin="16,-6,-12,-6">
                                    <TextBlock Text="{Binding GoIcon}" FontFamily="{StaticResource Icons}" FontSize="13" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource Link}" Content="Review the plan first" Command="{Binding GoCmd}" CommandParameter="auto" Foreground="{StaticResource Muted}" FontSize="15" Margin="26,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>

                <!-- three quiet numbers, each one opens its page -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" c:Entrance.Delay="200">
                    <Button Style="{StaticResource Plain}" Command="{Binding GoCmd}" CommandParameter="optimize" Margin="0,0,56,0" Cursor="Hand" AutomationProperties.Name="Open Optimize">
                        <StackPanel>
                            <TextBlock FontSize="34" FontWeight="Medium" Foreground="{StaticResource Text}"><Run Text="{Binding Opt.OnCount, Mode=OneWay}" /><Run Text="{Binding Opt.Available, Mode=OneWay, StringFormat={} / {0}}" FontSize="18" Foreground="{StaticResource Faint}" /></TextBlock>
                            <TextBlock Text="tweaks on" FontSize="13.5" Foreground="{StaticResource Muted}" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Plain}" Command="{Binding GoCmd}" CommandParameter="health" Margin="0,0,56,0" Cursor="Hand" AutomationProperties.Name="Open PC fixes">
                        <StackPanel>
                            <TextBlock Text="{Binding Fixes}" FontSize="34" FontWeight="Medium" Foreground="{StaticResource Text}" />
                            <TextBlock Text="{Binding FixesSub}" FontSize="13.5" Foreground="{StaticResource Muted}" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Plain}" Command="{Binding GoCmd}" CommandParameter="library" Cursor="Hand" AutomationProperties.Name="Open Games">
                        <StackPanel>
                            <TextBlock Text="{Binding Games}" FontSize="34" FontWeight="Medium" Foreground="{StaticResource Text}" />
                            <TextBlock Text="{Binding GamesSub}" FontSize="13.5" Foreground="{StaticResource Muted}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </DataTemplate>
</ResourceDictionary>
