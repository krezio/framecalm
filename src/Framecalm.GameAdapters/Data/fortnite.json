{
  "id": "fortnite",
  "cover": "store:BT5P2X999VH2",
  "name": "Fortnite",
  "support": "automatic",
  "adapter": "unreal-ini",
  "processNames": ["FortniteClient-Win64-Shipping"],
  "epicIds": ["Fortnite"],
  "nameMatches": ["Fortnite"],
  "antiCheat": "Easy Anti-Cheat / BattlEye",
  "configPath": "%LOCALAPPDATA%\\FortniteGame\\Saved\\Config\\WindowsClient\\GameUserSettings.ini",
  "restartNote": "Close Fortnite first. If Fortnite restores your old settings from the cloud, Framecalm tells you and switches to guided steps.",
  "notes": "Only the settings file is edited. The game, its files and its anti-cheat are never touched.",
  "version": { "requiredSection": "ScalabilityGroups", "requiredKeys": ["ScalabilityGroups|sg.ShadowQuality", "ScalabilityGroups|sg.ViewDistanceQuality", "/Script/FortniteGame.FortGameUserSettings|FrameRateLimit"] },
  "settings": [
    { "key": "FrameRateLimit", "section": "/Script/FortniteGame.FortGameUserSettings", "label": "Frame rate limit", "kind": "float", "unit": "fps", "faster": "higher", "special": "refresh",
      "targets": {}, "load": "both", "visualCost": 1, "typicalGain": 0,
      "why": "Your limit was below your screen's refresh rate.", "tradeoff": "None. The GPU works harder only when it has room." },
    { "key": "sg.ShadowQuality", "section": "ScalabilityGroups", "label": "Shadows", "kind": "int", "faster": "lower",
      "valueLabels": { "0": "Off", "1": "Medium", "2": "High", "3": "Epic", "4": "Cinematic" },
      "targets": { "light": "2", "balanced": "1", "performance": "0", "maxfps": "0" }, "load": "gpu", "visualCost": 3, "typicalGain": 30,
      "why": "Shadows are the most expensive setting in Fortnite on almost every GPU.", "tradeoff": "Fewer or no shadows. Many competitive players run them off anyway." },
    { "key": "sg.GlobalIlluminationQuality", "section": "ScalabilityGroups", "label": "Global illumination", "kind": "int", "faster": "lower",
      "valueLabels": { "0": "Low", "1": "Medium", "2": "High", "3": "Epic", "4": "Cinematic" },
      "targets": { "light": "2", "balanced": "1", "performance": "0", "maxfps": "0" }, "load": "gpu", "visualCost": 3, "typicalGain": 18,
      "why": "Bounced light (Lumen) is very heavy on mid-range and laptop GPUs.", "tradeoff": "Flatter indoor lighting." },
    { "key": "sg.ReflectionQuality", "section": "ScalabilityGroups", "label": "Reflections", "kind": "int", "faster": "lower",
      "valueLabels": { "0": "Low", "1": "Medium", "2": "High", "3": "Epic", "4": "Cinematic" },
      "targets": { "light": "2", "balanced": "1", "performance": "0", "maxfps": "0" }, "load": "gpu", "visualCost": 2, "typicalGain": 8,
      "why": "Screen-space and Lumen reflections cost GPU time every frame.", "tradeoff": "Duller water and shiny surfaces." },
    { "key": "sg.EffectsQuality", "section": "ScalabilityGroups", "label": "Effects", "kind": "int", "faster": "lower",
      "valueLabels": { "0": "Low", "1": "Medium", "2": "High", "3": "Epic", "4": "Cinematic" },
      "targets": { "light": "2", "balanced": "1", "performance": "0", "maxfps": "0" }, "load": "gpu", "visualCost": 2, "typicalGain": 8,
      "why": "Explosions and builds spawn lots of effects. Lower keeps fights smooth.", "tradeoff": "Simpler explosions and smoke." },
    { "key": "sg.PostProcessQuality", "section": "ScalabilityGroups", "label": "Post processing", "kind": "int", "faster": "lower",
      "valueLabels": { "0": "Low", "1": "Medium", "2": "High", "3": "Epic", "4": "Cinematic" },
      "targets": { "light": "2", "balanced": "1", "performance": "0", "maxfps": "0" }, "load": "gpu", "visualCost": 2, "typicalGain": 6,
      "why": "Bloom, depth of field and colour effects are drawn after every frame.", "tradeoff": "Less glow and softer cinematic touches." },
    { "key": "sg.FoliageQuality", "section": "ScalabilityGroups", "label": "Foliage", "kind": "int", "faster": "lower",
      "valueLabels": { "0": "Low", "1": "Medium", "2": "High", "3": "Epic", "4": "Cinematic" },
      "targets": { "balanced": "1", "performance": "0", "maxfps": "0" }, "load": "both", "visualCost": 2, "typicalGain": 5,
      "why": "Less grass and bushes to draw.", "tradeoff": "Sparser fields. Also easier to spot players." },
    { "key": "sg.ViewDistanceQuality", "section": "ScalabilityGroups", "label": "View distance", "kind": "int", "faster": "lower",
      "valueLabels": { "0": "Near", "1": "Medium", "2": "Far", "3": "Epic", "4": "Cinematic" },
      "targets": { "light": "3", "balanced": "2", "performance": "1", "maxfps": "1" }, "load": "cpu", "visualCost": 3, "typicalGain": 8,
      "why": "Fewer far objects for the CPU to prepare each frame.", "tradeoff": "Distant buildings and players appear later. Never set below Medium on purpose." },
    { "key": "bUseVSync", "section": "/Script/FortniteGame.FortGameUserSettings", "label": "V-Sync", "kind": "bool", "faster": "false",
      "targets": { "performance": "false", "maxfps": "false" }, "load": "gpu", "visualCost": 1, "typicalGain": 6,
      "why": "V-Sync caps FPS to the screen and adds input delay.", "tradeoff": "Possible tearing without G-Sync/FreeSync." },
    { "key": "bMotionBlur", "section": "/Script/FortniteGame.FortGameUserSettings", "label": "Motion blur", "kind": "bool", "faster": "false",
      "targets": { "light": "false", "balanced": "false", "performance": "false", "maxfps": "false" }, "load": "gpu", "visualCost": 1, "typicalGain": 2,
      "why": "Motion blur costs a little and smears what you're aiming at.", "tradeoff": "None for most players." }
  ]
}
