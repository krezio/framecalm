{
  "id": "rocket-league",
  "cover": "steam:252950",
  "name": "Rocket League",
  "support": "automatic",
  "adapter": "unreal-ini",
  "processNames": ["RocketLeague"],
  "steamIds": ["252950"],
  "epicIds": ["Sugar"],
  "nameMatches": ["Rocket League", "rocketleague"],
  "antiCheat": "Easy Anti-Cheat",
  "configPath": "%DOCUMENTS%\\My Games\\Rocket League\\TAGame\\Config\\TASystemSettings.ini",
  "restartNote": "Close Rocket League first. Changes load next time it starts.",
  "version": { "requiredSection": "SystemSettings", "requiredKeys": ["SystemSettings|DynamicShadows", "SystemSettings|DetailMode", "SystemSettings|Bloom"] },
  "settings": [
    { "key": "DynamicShadows", "section": "SystemSettings", "label": "Dynamic shadows", "kind": "bool", "faster": "false",
      "targets": { "balanced": "false", "performance": "false", "maxfps": "false" }, "load": "gpu", "visualCost": 2, "typicalGain": 15,
      "why": "Real-time car and ball shadows are the heaviest effect in Rocket League.", "tradeoff": "Flatter look. The ball's ground marker stays." },
    { "key": "LightShafts", "section": "SystemSettings", "label": "Light shafts", "kind": "bool", "faster": "false",
      "targets": { "balanced": "false", "performance": "false", "maxfps": "false" }, "load": "gpu", "visualCost": 1, "typicalGain": 5,
      "why": "God rays cost GPU time for almost no gameplay value.", "tradeoff": "Less dramatic lighting." },
    { "key": "Bloom", "section": "SystemSettings", "label": "Bloom", "kind": "bool", "faster": "false",
      "targets": { "performance": "false", "maxfps": "false" }, "load": "gpu", "visualCost": 1, "typicalGain": 4,
      "why": "Skips the glow pass on bright surfaces.", "tradeoff": "Less glow on boost and lights." },
    { "key": "DepthOfField", "section": "SystemSettings", "label": "Depth of field", "kind": "bool", "faster": "false",
      "targets": { "light": "false", "balanced": "false", "performance": "false", "maxfps": "false" }, "load": "gpu", "visualCost": 1, "typicalGain": 3,
      "why": "Background blur costs GPU time and makes far things harder to read.", "tradeoff": "None in matches." },
    { "key": "AmbientOcclusion", "section": "SystemSettings", "label": "Ambient occlusion", "kind": "bool", "faster": "false",
      "targets": { "performance": "false", "maxfps": "false" }, "load": "gpu", "visualCost": 2, "typicalGain": 6,
      "why": "Contact shadows in corners are expensive on integrated and laptop GPUs.", "tradeoff": "Slightly flatter cars and stadium." },
    { "key": "MotionBlur", "section": "SystemSettings", "label": "Motion blur", "kind": "bool", "faster": "false",
      "targets": { "light": "false", "balanced": "false", "performance": "false", "maxfps": "false" }, "load": "gpu", "visualCost": 1, "typicalGain": 2,
      "why": "Blur costs a little and smears fast plays.", "tradeoff": "None for most players." },
    { "key": "DetailMode", "section": "SystemSettings", "label": "World detail", "kind": "int", "faster": "lower",
      "valueLabels": { "0": "Performance", "1": "Quality", "2": "High quality" },
      "targets": { "balanced": "1", "performance": "1", "maxfps": "0" }, "load": "both", "visualCost": 3, "typicalGain": 10,
      "why": "Fewer stadium details and crowd objects to draw.", "tradeoff": "Plainer arenas." },
    { "key": "MaxAnisotropy", "section": "SystemSettings", "label": "Texture filtering", "kind": "int", "unit": "x", "faster": "lower",
      "targets": { "maxfps": "4" }, "load": "gpu", "visualCost": 2, "typicalGain": 2,
      "why": "Slightly less texture work at sharp angles.", "tradeoff": "Field lines a bit blurrier far away." }
  ]
}
