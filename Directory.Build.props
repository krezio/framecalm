<Project>
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Version>0.6.0</Version>
    <Company>krezio</Company>
    <Authors>krezio</Authors>
    <Product>Framecalm</Product>
    <Copyright>© 2026 krezio</Copyright>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <NoWarn>$(NoWarn);CA1416;SYSLIB1054;CS1591</NoWarn>
    <!-- .NET marks apps CET-compatible by default. On Windows 10 builds without the matching update
         (special user-mode APCs), the runtime then refuses to start with error 0x80131506. -->
    <CETCompat>false</CETCompat>
  </PropertyGroup>
</Project>
